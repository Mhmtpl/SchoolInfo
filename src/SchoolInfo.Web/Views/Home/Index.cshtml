@{
    ViewData["Title"] = "Veliport | Okul Öncesi Bilgi Platformu";
}

<div class="landing-container">
    <!-- HERO SECTION -->
    <header class="landing-hero">
        <div class="hero-badge-container">
            <span class="hero-badge">✨ Okul Öncesi Eğitim Platformu</span>
        </div>
        <h1 class="hero-title">
            Çocuğunuzun Okuldaki Her Günü <span class="gradient-text">Gözünüzün Önünde</span>
        </h1>
        <p class="hero-subtitle">
            Öğretmenler ile veliler arasında en akıllı, en şeffaf köprü. Yapay zeka destekli günlük özetler, anlık durum takipleri ve dijital bültenler tek bir platformda.
        </p>
        <div class="hero-actions" style="display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 1rem;">
            <a asp-controller="Account" asp-action="Login" class="btn-landing-primary">Sisteme Giriş Yap</a>
            <a href="/downloads/veliport-v2.apk" class="btn-landing-secondary" download style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(6, 182, 212, 0.08); border-color: rgba(6, 182, 212, 0.3); color: var(--accent-cyan);"><span style="font-size: 1.15rem;">🤖</span> Android APK İndir</a>
            <a href="#features" class="btn-landing-secondary">Özellikleri Keşfet</a>
        </div>
    </header>

    <!-- INTERACTIVE MOCKUP SECTION -->
    <section class="landing-showcase">
        <div class="glass-card mockup-card animate-float">
            <div class="mockup-header">
                <div class="mockup-student-profile">
                    <div class="mockup-avatar">👶</div>
                    <div class="mockup-student-details">
                        <h3>Alp Demir</h3>
                        <span class="mockup-badge">Yıldızlar Sınıfı</span>
                    </div>
                </div>
                <div class="mockup-date">24 Temmuz 2026</div>
            </div>

            <div class="mockup-grid">
                <!-- Water Tracker Mockup -->
                <div class="mockup-stat-item">
                    <span class="mockup-stat-icon">💧</span>
                    <div class="mockup-stat-info">
                        <h4>Su Tüketimi</h4>
                        <div class="mockup-water-bar-bg">
                            <div class="mockup-water-bar-fill" style="width: 75%;"></div>
                        </div>
                        <span class="mockup-stat-meta">750 ml / 1000 ml</span>
                    </div>
                </div>

                <!-- Sleep Status Mockup -->
                <div class="mockup-stat-item">
                    <span class="mockup-stat-icon">🌙</span>
                    <div class="mockup-stat-info">
                        <h4>Uyku Durumu</h4>
                        <span class="mockup-sleep-badge">13:30 - 15:00 Uyudu</span>
                    </div>
                </div>

                <!-- Food Status Mockup -->
                <div class="mockup-stat-item">
                    <span class="mockup-stat-icon">🍲</span>
                    <div class="mockup-stat-info">
                        <h4>Öğle Yemeği</h4>
                        <span class="mockup-meal-badge">Tümünü Bitirdi</span>
                    </div>
                </div>

                <!-- Smart Watch / Heart Rate Mockup -->
                <div class="mockup-stat-item">
                    <span class="mockup-stat-icon">⌚</span>
                    <div class="mockup-stat-info">
                        <h4>Canlı Biyometrik Veri</h4>
                        <div style="display: flex; align-items: center; gap: 0.35rem; margin-top: 0.25rem;">
                            <span class="landing-heart-pulse" style="color: #ef4444; font-size: 1.1rem;">❤️</span>
                            <span style="font-weight: 700; color: #ef4444; font-size: 1.1rem; font-family: monospace;">98 BPM</span>
                            <span class="mockup-stat-meta" style="font-size: 0.75rem; color: #10b981; font-weight: 700; background: rgba(16, 185, 129, 0.1); padding: 0.1rem 0.4rem; border-radius: 6px;">Canlı</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- AI Summary Mockup -->
            <div class="mockup-ai-summary">
                <div class="mockup-ai-badge">🤖 VELİPORT AI GÜNLÜK ÖZETİ</div>
                <p class="mockup-ai-text">
                    "Alp bugün okulda harika bir gün geçirdi! 🌟 Sabah boyama etkinliğinde çok yaratıcıydı ve arkadaşlarıyla boyalarını paylaştı. Öğle yemeğini tamamen bitirdi ve öğleden sonra 1.5 saat dinlendirici bir uyku uyudu. Su tüketim hedefine yaklaştı. Bugünün yıldızıydı!"
                </p>
            </div>
        </div>
    </section>

    <!-- DATA FLOW SYSTEM SCHEMA SECTION -->
    <section class="landing-schema-section">
        <div class="section-header text-center">
            <span class="hero-badge" style="background: rgba(139, 92, 246, 0.08); color: var(--accent-purple);">📡 BİYOMETRİ VE BİLGİ AKIŞ ŞEMASI</span>
            <h2 class="section-title" style="margin-top: 0.5rem;">Okuldan Eve Canlı Veri Köprüsü</h2>
            <p class="section-desc">Çocuğunuzun biyometrik verileri ile öğretmenlerin girdilerinin veli paneline ulaşma mimarisi.</p>
        </div>

        <div class="schema-diamond-container">
            <!-- Connectors (Hidden on Mobile) -->
            <div class="schema-line-h"></div>
            <div class="schema-line-v"></div>

            <!-- NODE 1: ÇOCUK (BİYOMETRİ) -->
            <div class="schema-diamond-node child-node">
                <span class="schema-node-badge live">⌚ CANLI YAYIN</span>
                <div class="schema-node-icon">👦⌚</div>
                <h4>Okuldaki Çocuk</h4>
                <p>Akıllı bileklik üzerinden anlık nabız ve hareket verileri kesintisiz olarak bulut sistemine iletilir.</p>
            </div>

            <!-- NODE 2: ÖĞRETMEN (AI SES/YAZI) -->
            <div class="schema-diamond-node teacher-node">
                <span class="schema-node-badge ai">🎙️ AI DESTEKLİ</span>
                <div class="schema-node-icon">👩‍🏫🎙️</div>
                <h4>Sınıftaki Öğretmen</h4>
                <p>Sesli notlar ve hızlı yazılı girdiler yapay zeka tarafından işlenerek anlık durum kayıtlarına dönüştürülür.</p>
            </div>

            <!-- CENTRAL HUB: VELİPORT BULUT & AI ENGINE -->
            <div class="schema-diamond-node hub-node">
                <div class="schema-node-icon">☁️🧠</div>
                <h4>Veliport AI & Bulut</h4>
                <p>Verileri işler, kritik sağlık sınırlarını analiz eder ve veliler için günlük hikayeleştirilmiş AI özetlerini üretir.</p>
            </div>

            <!-- NODE 3: VELİ (BİLDİRİM VE TAKİP) -->
            <div class="schema-diamond-node parent-node">
                <span class="schema-node-badge parent-badge">🏡 MOBİL & WEB</span>
                <div class="schema-node-icon">🏡📱</div>
                <h4>Evdeki / İşteki Veli</h4>
                <p>Veliport mobil uygulaması veya web paneli üzerinden canlı verileri izler ve anlık bildirimleri alır.</p>
            </div>
        </div>
    </section>

    <!-- FEATURES SECTION -->
    <section id="features" class="landing-features">
        <div class="section-header text-center">
            <h2 class="section-title">Neden Veliport?</h2>
            <p class="section-desc">Okul öncesi eğitim süreçlerini kolaylaştırmak ve velilerin içini rahatlatmak için tasarlanan modern özellikler.</p>
        </div>

        <div class="features-grid">
            <div class="glass-card feature-card">
                <div class="feature-icon bg-blue">📊</div>
                <h3>Anlık Durum Takibi</h3>
                <p>Çocuğunuzun gün içindeki uyku saatlerini, yemek yeme oranını ve su tüketimini öğretmenlerin sisteme girdiği an eş zamanlı olarak takip edin.</p>
            </div>

            <div class="glass-card feature-card">
                <div class="feature-icon bg-purple">🧠</div>
                <h3>Yapay Zeka Raporları</h3>
                <p>Karmaşık listeler yerine, yapay zeka teknolojimizin çocuğunuzun gününü tatlı ve okuması kolay bir günlük hikaye haline getirdiği özetleri okuyun.</p>
            </div>

            <div class="glass-card feature-card">
                <div class="feature-icon bg-green">📄</div>
                <h3>Dijital Bülten ve PDF</h3>
                <p>Aylık yemek listelerine, haftalık eğitim bültenlerine ve okul duyurularına anında erişin, dilediğiniz an PDF olarak cihazınıza indirin.</p>
            </div>

            <div class="glass-card feature-card">
                <div class="feature-icon bg-red">⌚</div>
                <h3>Akıllı Saat Entegrasyonu</h3>
                <p>Çocuğunuzun okul saatlerindeki anlık nabız değerlerini IoT destekli akıllı bileklikler üzerinden canlı ve geriye dönük güvenle takip edin.</p>
            </div>

            <div class="glass-card feature-card">
                <div class="feature-icon bg-blue">🎙️</div>
                <h3>Sesli & Yazılı AI Girişi</h3>
                <p>Öğretmenler için geliştirilen yapay zeka entegrasyonu sayesinde, sadece konuşarak veya kısa notlar yazarak sınıf verilerini saniyeler içinde sisteme kaydedin.</p>
            </div>

            <div class="glass-card feature-card">
                <div class="feature-icon bg-amber">🔒</div>
                <h3>Rol Tabanlı Güvenli Erişim</h3>
                <p>Yöneticiler, öğretmenler ve veliler için ayrı ayrı optimize edilmiş panellerle yetkilendirilmiş, güvenli ve sade bir kullanıcı deneyimi.</p>
            </div>
        </div>
    </section>

    <!-- TARGET AUDIENCES -->
    <section class="landing-audiences">
        <div class="section-header text-center">
            <h2 class="section-title">Herkes İçin Veliport</h2>
            <p class="section-desc">Eğitim ekosistemindeki tüm paydaşlar için süreci kolaylaştırıyor, bağları güçlendiriyoruz.</p>
        </div>

        <div class="audiences-grid">
            <div class="audience-card">
                <div class="audience-header">
                    <span class="audience-emoji">🏡</span>
                    <h3>Veliler İçin</h3>
                </div>
                <p>Çocuğum bugün ne yedi, uyudu mu sorularını geride bırakın. Gün içindeki tüm detaylara işteyken veya evdeyken tek tıkla ulaşarak huzurlu kalın.</p>
            </div>

            <div class="audience-card">
                <div class="audience-header">
                    <span class="audience-emoji">🏫</span>
                    <h3>Öğretmenler İçin</h3>
                </div>
                <p>Kağıt bülten doldurma yükünden kurtulun. Hızlı veri giriş arayüzü sayesinde öğrencilerin durumlarını saniyeler içinde kaydedin, eğitime daha çok zaman ayırın.</p>
            </div>

            <div class="audience-card">
                <div class="audience-header">
                    <span class="audience-emoji">👑</span>
                    <h3>Yöneticiler İçin</h3>
                </div>
                <p>Sınıfları, öğretmen yetkilerini, bültenleri ve veli listelerini tek bir yönetim panelinden kontrol edin. Okulunuzun kurumsallığını ve prestijini artırın.</p>
            </div>
        </div>
    </section>

    <!-- CTA BANNER -->
    <section class="landing-cta">
        <div class="glass-card cta-card text-center">
            <h2>Veliport Dünyasına Adım Atın</h2>
            <p>Veliport Okul Öncesi Bilgi Platformu ile tanışmak ve okulunuzda bu deneyimi sunmak için hemen giriş yapın veya bizimle iletişime geçin.</p>
            <div class="cta-actions">
                <a asp-controller="Account" asp-action="Login" class="btn-landing-primary">Sisteme Giriş Yap</a>
            </div>
        </div>
    </section>
</div>

