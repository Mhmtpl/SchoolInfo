@using SchoolInfo.Application.Features.Schools.Queries.GetSchool
@model List<SchoolDto>
@{
    ViewData["Title"] = "Okul Yönetimi";
    Layout = "_AdminLayout";
}

<div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-bold text-slate-800">Kayıtlı Okullar</h2>
    <button onclick="document.getElementById('addSchoolModal').classList.remove('hidden')" class="bg-brand-600 hover:bg-brand-700 text-white px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2">
        <i class="ph ph-plus-circle text-lg"></i>
        Yeni Okul Ekle
    </button>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="bg-red-50 text-red-600 p-4 rounded-lg mb-6 border border-red-100 flex items-center gap-3">
        <i class="ph-fill ph-warning-circle text-xl"></i>
        @ViewBag.ErrorMessage
    </div>
}

<div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 border-b border-slate-200 text-slate-600">
                <tr>
                    <th class="py-3 px-6 font-semibold">Okul Adı</th>
                    <th class="py-3 px-6 font-semibold">Okul ID (Guid)</th>
                    <th class="py-3 px-6 font-semibold text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
                @if (Model != null && Model.Any())
                {
                    foreach (var school in Model)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="py-3 px-6 font-medium text-slate-800">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded bg-brand-100 text-brand-600 flex items-center justify-center">
                                        <i class="ph-fill ph-buildings"></i>
                                    </div>
                                    @school.Name
                                </div>
                            </td>
                            <td class="py-3 px-6 text-slate-500 font-mono text-xs">@school.Id</td>
                            <td class="py-3 px-6 text-right">
                                <button onclick="openEditModal('@school.Id', '@school.Name')" class="text-blue-600 hover:text-blue-800 mr-3 transition-colors" title="Düzenle">
                                    <i class="ph ph-pencil-simple text-lg"></i>
                                </button>
                                <form asp-action="DeleteSchool" asp-controller="Admin" method="post" class="inline" onsubmit="return confirm('Bu okulu silmek istediğinize emin misiniz? Bu işlem geri alınamaz!');">
                                    <input type="hidden" name="id" value="@school.Id" />
                                    <button type="submit" class="text-red-600 hover:text-red-800 transition-colors" title="Sil">
                                        <i class="ph ph-trash text-lg"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="py-8 text-center text-slate-500">
                            Henüz kayıtlı okul bulunmuyor.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Ekleme Modalı -->
<div id="addSchoolModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden z-50 flex items-center justify-center">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md mx-4 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
            <h3 class="font-semibold text-lg text-slate-800">Yeni Okul Ekle</h3>
            <button onclick="document.getElementById('addSchoolModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                <i class="ph ph-x text-xl"></i>
            </button>
        </div>
        <form asp-action="CreateSchool" asp-controller="Admin" method="post">
            <div class="p-6">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Okul Adı</label>
                    <input type="text" name="name" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none" placeholder="Örn: Yıldız Koleji" />
                </div>
            </div>
            <div class="px-6 py-4 border-t border-slate-200 flex justify-end gap-3 bg-slate-50">
                <button type="button" onclick="document.getElementById('addSchoolModal').classList.add('hidden')" class="px-4 py-2 text-slate-600 hover:bg-slate-200 rounded-lg font-medium transition-colors">İptal</button>
                <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-lg font-medium transition-colors">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<!-- Düzenleme Modalı -->
<div id="editSchoolModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden z-50 flex items-center justify-center">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md mx-4 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
            <h3 class="font-semibold text-lg text-slate-800">Okulu Düzenle</h3>
            <button onclick="document.getElementById('editSchoolModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
                <i class="ph ph-x text-xl"></i>
            </button>
        </div>
        <form asp-action="UpdateSchool" asp-controller="Admin" method="post">
            <input type="hidden" name="id" id="editSchoolId" />
            <div class="p-6">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Okul Adı</label>
                    <input type="text" name="name" id="editSchoolName" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none" />
                </div>
            </div>
            <div class="px-6 py-4 border-t border-slate-200 flex justify-end gap-3 bg-slate-50">
                <button type="button" onclick="document.getElementById('editSchoolModal').classList.add('hidden')" class="px-4 py-2 text-slate-600 hover:bg-slate-200 rounded-lg font-medium transition-colors">İptal</button>
                <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors">Güncelle</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openEditModal(id, name) {
            document.getElementById('editSchoolId').value = id;
            document.getElementById('editSchoolName').value = name;
            document.getElementById('editSchoolModal').classList.remove('hidden');
        }
    </script>
}
